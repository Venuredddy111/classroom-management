# PostgreSQL connection string used by Prisma.
# If you use the included docker-compose.yml, this matches it out of the box.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/classroom?schema=public"

# Port the Express server listens on.
PORT=8000

# Origin of the frontend app, used for CORS + better-auth trusted origins.
CLIENT_ORIGIN="http://localhost:5173"

# better-auth needs a long random secret in production.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-this-to-a-long-random-string"

# Base URL of this API (better-auth uses this to build absolute callback URLs).
BETTER_AUTH_URL="http://localhost:8000"

# Run Arcjet in development <https://docs.arcjet.com/environment#arcjet-env>.
ARCJET_ENV=development
# Arcjet key for your site (from <https://console.arcjet.com>).
# More info: <https://docs.arcjet.com/environment#arcjet-key>.
ARCJET_KEY=

# Site24x7 APM Insight (optional). Get a license key from your Site24x7
# account. Prefer these env vars over committing an apminsightnode.json file.
APMINSIGHT_LICENSE_KEY=
APMINSIGHT_APP_NAME=classroom-backend
