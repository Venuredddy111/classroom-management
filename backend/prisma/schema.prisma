// Prisma schema for the Classroom Management API.
// Mirrors the schemas defined in swagger.json, plus the tables better-auth
// needs for email/password authentication (User, Session, Account, Verification).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  teacher
  student
}

enum ClassStatus {
  active
  inactive
  archived
}

// --- better-auth tables -----------------------------------------------

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  emailVerified  Boolean  @default(false)
  image          String?
  imageCldPubId  String?
  role           Role     @default(student)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sessions    Session[]
  accounts    Account[]
  classes     Class[]      @relation("TeacherClasses")
  enrollments Enrollment[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  issuer                String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())         
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// --- domain tables -------------------------------------------------------

model Department {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(255)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subjects Subject[]

  @@map("department")
}

model Subject {
  id           Int      @id @default(autoincrement())
  departmentId Int
  name         String   @db.VarChar(255)
  code         String   @unique @db.VarChar(50)
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id])
  classes    Class[]

  @@map("subject")
}

model Class {
  id             Int         @id @default(autoincrement())
  name           String      @db.VarChar(255)
  inviteCode     String      @unique @db.VarChar(20)
  subjectId      Int
  teacherId      String
  description    String?
  bannerUrl      String?
  bannerCldPubId String?
  capacity       Int         @default(50)
  status         ClassStatus @default(active)
  // Array of { day, startTime, endTime } objects (see Schedule schema in swagger.json)
  schedules      Json        @default("[]")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  subject     Subject      @relation(fields: [subjectId], references: [id])
  teacher     User         @relation("TeacherClasses", fields: [teacherId], references: [id])
  enrollments Enrollment[]

  @@map("class")
}

model Enrollment {
  id          Int      @id @default(autoincrement())
  studentId   String
  classId     Int
  enrolledAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student User  @relation(fields: [studentId], references: [id])
  class   Class @relation(fields: [classId], references: [id])

  @@unique([studentId, classId])
  @@map("enrollment")
}
